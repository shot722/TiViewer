<Window x:Class="TiViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TiViewer.ViewModels"
        xmlns:views="clr-namespace:TiViewer.Views"
        Title="TiViewer Ultra"
        Width="1400" Height="900"
        Background="#12161d"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1a1d24" BorderBrush="#2a2f3d" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <Button Content="Choose Folder"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#3a86ff"
                        BorderBrush="#3a86ff"
                        Command="{Binding ChooseFolderCommand}"/>

                <TextBlock Text="Library"
                           Margin="0,18,0,8"
                           Foreground="#a8b5c7"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <ListBox ItemsSource="{Binding Images}"
                         SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="8" Background="#202632" CornerRadius="12">
                                <StackPanel>
                                    <Border Background="#101418" CornerRadius="10" Width="200" Height="120">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" Foreground="#edf3ff" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#111820" Padding="12">
            <Grid>
                <views:ImageView DataContext="{Binding SelectedImage}"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="#171d27" BorderBrush="#2a2f3d" BorderThickness="1,0,0,0" Padding="16">
            <views:MetadataPanel DataContext="{Binding SelectedImage.Metadata}"/>
        </Border>
    </Grid>
</Window>
